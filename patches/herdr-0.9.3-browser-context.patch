@@ -0,0 +1,100 @@
+use super::*;
+
+impl ClientShellState {
+    /// Requests are scoped to this client's currently visible server incarnation.
+    pub(crate) fn browser_select(
+        &mut self,
+        request: crate::client::browser_context::SelectionRequest,
+    ) -> Vec<ClientShellAction> {
+        let valid = request.endpoint == self.active_endpoint_id.storage_key()
+            && self.endpoint_status(&self.active_endpoint_id) == Some(ClientEndpointStatus::Online)
+            && self.snapshot.as_ref().is_some_and(|snapshot| {
+                snapshot.boot_id == request.boot_id
+                    && snapshot.tabs.iter().any(|tab| tab.tab_id == request.tab_id)
+            });
+        if !valid {
+            return Vec::new();
+        }
+        self.focus_endpoint_target(ClientEndpointFocusTarget::Tab(request.tab_id))
+    }
+
+    /// Uses this client's selected endpoint and projection, never shared API focus.
+    pub(crate) fn browser_projection(&self) -> crate::client::browser_context::Projection<'_> {
+        crate::client::browser_context::Projection {
+            endpoint: &self.active_endpoint_id,
+            endpoint_label: self.active_endpoint_label(),
+            online: self.endpoint_status(&self.active_endpoint_id)
+                == Some(ClientEndpointStatus::Online),
+            snapshot: self.snapshot.as_deref(),
+        }
+    }
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+    use crate::client::browser_context::SelectionRequest;
+
+    fn state() -> ClientShellState {
+        let mut shell = ClientShellState::new(ClientShellConfig::from_config(&Config::default()));
+        shell.set_snapshot(Box::new(super::super::tests::snapshot()));
+        shell.set_endpoint_status(&ClientEndpointId::Local, ClientEndpointStatus::Online);
+        shell
+    }
+
+    fn request(endpoint: &str, boot_id: &str, tab_id: &str) -> SelectionRequest {
+        SelectionRequest {
+            endpoint: endpoint.into(),
+            boot_id: boot_id.into(),
+            tab_id: tab_id.into(),
+        }
+    }
+
+    #[test]
+    fn browser_context_selection_rejects_other_servers_and_deleted_tasks() {
+        let mut shell = state();
+        for invalid in [
+            request("ssh:other", "boot-1", "tab_1"),
+            request("local", "old-boot", "tab_1"),
+            request("local", "boot-1", "deleted"),
+        ] {
+            assert!(shell.browser_select(invalid).is_empty());
+        }
+        let actions = shell.browser_select(request("local", "boot-1", "tab_1"));
+        assert!(matches!(
+            &actions[..],
+            [ClientShellAction::Endpoint { endpoint_id: ClientEndpointId::Local, request, .. }]
+                if matches!(&request.method, crate::api::schema::Method::TabFocus(target)
+                    if target.tab_id == "tab_1")
+        ));
+        shell.set_endpoint_status(&ClientEndpointId::Local, ClientEndpointStatus::Reconnecting);
+        assert!(shell
+            .browser_select(request("local", "boot-1", "tab_1"))
+            .is_empty());
+    }
+
+    #[test]
+    fn browser_context_projection_uses_each_clients_selection() {
+        let first = state();
+        let mut second = state();
+        second.snapshot.as_mut().unwrap().focused_tab_id = Some("tab_2".into());
+        assert_eq!(
+            first
+                .browser_projection()
+                .snapshot
+                .unwrap()
+                .focused_tab_id
+                .as_deref(),
+            Some("tab_1")
+        );
+        assert_eq!(
+            second
+                .browser_projection()
+                .snapshot
+                .unwrap()
+                .focused_tab_id
+                .as_deref(),
+            Some("tab_2")
+        );
+    }
+}
